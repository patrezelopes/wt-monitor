#!/usr/bin/env python3
"""Hook Stop do Claude Code: envia a última mensagem do agente ao painel wt-monitor.
Nunca falha nem bloqueia o agente: sem painel no ar, apenas sai."""
import json, os, sys, urllib.request

PORT = os.environ.get("WT_PORT", "8765")


def last_assistant_text(path):
    try:
        with open(path, "rb") as f:
            f.seek(0, 2)
            f.seek(max(0, f.tell() - 262144))
            lines = f.read().decode("utf-8", "replace").splitlines()
    except OSError:
        return ""
    for line in reversed(lines):
        try:
            e = json.loads(line)
        except ValueError:
            continue
        m = e.get("message") or {}
        if e.get("type") != "assistant" and m.get("role") != "assistant":
            continue
        c = m.get("content")
        if isinstance(c, str) and c.strip():
            return c.strip()
        if isinstance(c, list):
            t = "\n".join(b.get("text", "") for b in c if isinstance(b, dict) and b.get("type") == "text").strip()
            if t:
                return t
    return ""


def main():
    try:
        d = json.load(sys.stdin)
    except ValueError:
        return
    msg = d.get("last_assistant_message") or last_assistant_text(d.get("transcript_path", ""))
    body = f"cwd: {d.get('cwd', '')}\nsession: {str(d.get('session_id', ''))[:8]}\n\n{str(msg)[:2000]}"
    req = urllib.request.Request(
        f"http://127.0.0.1:{PORT}/event", data=body.encode(), method="POST",
        headers={"X-WT": "1", "Content-Type": "text/plain; charset=utf-8"},
    )
    try:
        urllib.request.urlopen(req, timeout=2).read()
    except Exception:
        pass


main()
